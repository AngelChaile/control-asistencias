# Variables públicas que ya utiliza el navegador (completar con el proyecto real).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Activar sólo después de configurar el servidor y migrar los perfiles.
VITE_SEGURIDAD_ACTIVA=false

# Sólo servidor. En Vercel: contenido JSON completo de la cuenta de servicio.
# No usar prefijo VITE_, no subir el archivo ni la clave a GitHub.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternativa local: ruta al JSON descargado, fuera del repositorio.
# GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/privada/service-account.json
